# Optional for live-model responses. If empty, the acceptance API starts and
# returns an explicitly labelled deterministic fallback with an error record.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Shared Neo4j instance used by VentureAgent and ClassLoop
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_BROWSER_URL=http://127.0.0.1:7474
