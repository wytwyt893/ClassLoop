CLASSLOOP_HOST=127.0.0.1
CLASSLOOP_PORT=8100
CLASSLOOP_DATABASE_PATH=./data/classloop.db
CLASSLOOP_TOKEN_TTL_HOURS=168
CLASSLOOP_ADMIN_EMAIL=admin@classloop.local
CLASSLOOP_ADMIN_PASSWORD=classloop-admin

CLASSLOOP_NEO4J_URI=bolt://127.0.0.1:7688
CLASSLOOP_NEO4J_USER=neo4j
CLASSLOOP_NEO4J_PASSWORD=classloop-graph
CLASSLOOP_NEO4J_DATABASE=neo4j

# 可选：ClassLoop 只通过 HTTP 调用外部 VentureAgent，不导入或修改其源码。
# VentureAgent 未启动或未配置时，课堂基础功能仍可使用，诊断按钮会返回明确错误。
CLASSLOOP_AGENT_BASE_URL=http://127.0.0.1:8140
CLASSLOOP_AGENT_MODEL=deepseek-chat
CLASSLOOP_AGENT_TIMEOUT_SECONDS=45
